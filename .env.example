# ParkSmart Environment Configuration
# Copy to .env and customize before running

# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-string

# Database (SQLite for local, change to PostgreSQL for production)
# Local: sqlite:////app/data/parksmart.db
# Cloud: postgresql://user:password@rds-endpoint:5432/parksmart
DATABASE_URL=sqlite:////app/data/parksmart.db

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (comma-separated origins, * for all)
CORS_ORIGINS=*

# Frontend
VITE_API_URL=/api

# AWS (never commit actual values)
# AWS_REGION=ap-south-1
# AWS_ACCOUNT_ID=<your-account-id>
# ECR_FRONTEND_REPO=parksmart-frontend
# ECR_BACKEND_REPO=parksmart-backend
